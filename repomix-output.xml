        actions.addWidget(
            self.delete_button
        )


        left_side.addLayout(
            actions
        )



        # ======================================
        # RIGHT SIDE
        # PREVIEW FULL HEIGHT
        # ======================================


        preview_frame = QFrame()

        preview_frame.setObjectName(
            "innerPanel"
        )



        preview_layout = QVBoxLayout(
            preview_frame
        )


        preview_layout.setContentsMargins(
            12,
            12,
            12,
            12
        )


        preview_layout.setSpacing(
            10
        )



