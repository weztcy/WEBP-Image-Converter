    )


    print(
        f"Total images: {len(images)}"
    )



    if not images:


        print(
            "No images found"
        )


        return



    # ==========================
    # WEBP SETTINGS
    # ==========================

    settings = {

        "mode": "lossy",

        "quality": 80,

        "profile": "compression"

    }



    # ==========================
    # CLEAN OUTPUT
    # ==========================

    if output_folder.exists():

        shutil.rmtree(
            output_folder
        )



    output_folder.mkdir(
